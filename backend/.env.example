# ============================================================
# GIG HUNTER — Environment Variables
# Copy this file:  cp .env.example .env
# Then fill in your real values below
# ============================================================

# --- Server ---
PORT=5000
NODE_ENV=development

# --- OpenAI ---
# Get your key → https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here

# --- Database ---
# SQLite file will be auto-created on first run
DB_PATH=./database.sqlite

# --- RSS Feed (replace with real Upwork/LinkedIn RSS later) ---
RSS_FEED_URL=https://api.mocki.io/v2/3f9b8f0e

# --- CORS ---
# Local dev → http://localhost:3000
# Production → https://your-app.vercel.app
CLIENT_URL=http://localhost:3000
MOCK_AI=true